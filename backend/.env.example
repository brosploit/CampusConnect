# Campus Connect Backend Configuration (.env.example)
# NEVER commit real credentials, passwords, or keys to source control.

# Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECRET=replace-with-a-cryptographically-secure-random-string-at-least-32-chars
CSRF_SECRET=replace-with-a-cryptographically-secure-random-string-at-least-32-chars

# JWT Authentication
JWT_ACCESS_SECRET=replace-with-a-cryptographically-secure-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-cryptographically-secure-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Password Reset Token Expiry (minutes)
PASSWORD_RESET_EXPIRATION_MINUTES=15

# Database Configuration (PostgreSQL)
# Runtime App Connection (Least Privilege: cc_api_user)
DATABASE_URL=postgresql://cc_api_user:replace_with_db_password@localhost:5432/campus_connect?sslmode=prefer
# Migration Connection (DDL Privileges: cc_migration_user)
DATABASE_MIGRATION_URL=postgresql://cc_migration_user:replace_with_migration_password@localhost:5432/campus_connect?sslmode=prefer

# Rate Limiting (Requests per Window)
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_READINGS_MAX=10
RATE_LIMIT_READINGS_WINDOW_MS=60000
RATE_LIMIT_BATCH_MAX=5
RATE_LIMIT_BATCH_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000

# Diagnostic & Anomaly Thresholds
MAX_BATCH_SIZE=50
MIN_SAMPLE_THRESHOLD=5
MIN_DISTINCT_DEVICES=3
MAX_MONITORING_DURATION_MINUTES=30
