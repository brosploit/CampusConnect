# Campus Connect Local Development Environment (.env)
# SAFE PLACEHOLDERS FOR LOCAL DEVELOPMENT ONLY. NEVER USE IN PRODUCTION.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECRET=campus_connect_dev_cookie_secret_32chars_long!
CSRF_SECRET=campus_connect_dev_csrf_secret_32chars_long!
JWT_ACCESS_SECRET=campus_connect_dev_jwt_access_secret_32_chars!
JWT_REFRESH_SECRET=campus_connect_dev_jwt_refresh_secret_32_chars!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7
PASSWORD_RESET_EXPIRATION_MINUTES=15

# PostgreSQL Connection (Default local superuser or cc_api_user)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_connect
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/campus_connect

# Local Dev In-Memory Database Mode
# Set to 'false' once your local PostgreSQL database is started and migrated.
USE_MEMORY_DB=true
